# Copy to .env.local and fill in. Never commit real values.

# ── Tooling (local scripts only) ───────────────────────────────
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
EXPO_TOKEN=

# ── Supabase ───────────────────────────────────────────────────
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# Server-side only (Vercel). Never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Web / API (Vercel) ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Shared secret configured as the Authorization header in the RevenueCat webhook.
REVENUECAT_WEBHOOK_SECRET=
CRON_SECRET=

# ── Mobile app (public, bundled into the app) ──────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_SENTRY_DSN=
